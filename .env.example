# Free option: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Paid option (used instead of Gemini if set)
# ANTHROPIC_API_KEY=
# Leaderboard storage. Set this to a Postgres connection string (free: https://neon.tech)
# so scores survive redeploys. Leave empty to use JSON files in DATA_DIR (local dev).
DATABASE_URL=
# Optional: folder for the JSON files when DATABASE_URL is empty (default ./data)
# DATA_DIR=
